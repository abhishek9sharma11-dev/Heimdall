# --- Backend ---
# dry_run = simulate locally (terminal chat, no bridge)
# bridge  = talk to the C++ bridge over HTTP
ZOOM_BACKEND=dry_run

# --- C++ bridge ---
BRIDGE_URL=http://127.0.0.1:8765

# --- Meeting to join ---
MEETING_ID=
MEETING_PASSWORD=
# Optional: ZAK token if you're auto-starting as the host
MEETING_ZAK=

# --- Zoom SDK credentials ---
# Used by the bridge; kept here so .env is the single source of truth.
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=

# --- LLM (OpenAI-compatible: OpenRouter OR local Ollama) ---
# Remote OpenRouter:
#   OPENROUTER_API_KEY=sk-or-...
#   OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#   ANTHROPIC_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Local Ollama (no paid key):
#   OPENROUTER_API_KEY=ollama
#   OPENROUTER_BASE_URL=http://127.0.0.1:11434/v1
#   ANTHROPIC_MODEL=qwen2.5:3b
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ANTHROPIC_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Bot identity ---
# Display name MUST contain "AI" or "Assistant"
BOT_DISPLAY_NAME=Hermes AI
BOT_AVATAR_URL=https://example.com/heimdall.jpg
BOT_DISCLOSURE_LINE=Hi! Outskill co-host, happy to help while he's presenting.

# --- Host control (slash commands) ---
HOST_EMAIL=you@example.com

# --- Behavior ---
GREET_NEW_ATTENDEES=true
GREET_DELAY_SECONDS=3
GREET_MAX_PER_MINUTE=10
ANSWER_QUESTIONS=true
ANSWER_RATE_LIMIT_PER_USER_PER_MIN=2
# false = bot selects recipient + types reply, you click Submit (live test mode)
CHAT_AUTO_SUBMIT=true

# --- RAG ---
KNOWLEDGE_DIR=./knowledge
VECTOR_STORE_PATH=./vector_store
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=4

# --- Hermes Mission Control (dashboard) ---
# HERMES_PORT=8780
# Postgres — live payment totals per session (same query as Metabase)
DATABASE_URL=postgres://user:pass@host:5432/postgres

# --- Google Sheets Tracking sync (optional) ---
# Service-account JSON with Editor on the Workshops sheet. Do not commit the key.
# GOOGLE_SHEETS_CREDENTIALS=~/.config/hermes/sheets.json
# GOOGLE_SHEETS_ID=1Ykx3m5O9H07iipM-pE7um6ED1Lh0dCSok2iqaOmq4dw
# GOOGLE_SHEETS_TAB=Tracking

