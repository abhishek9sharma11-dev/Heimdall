# --- Backend ---
# dry_run = simulate locally (terminal chat, no bridge)
# bridge  = talk to the C++ bridge over HTTP
ZOOM_BACKEND=dry_run

# --- C++ bridge ---
BRIDGE_URL=http://127.0.0.1:8765

# --- Meeting to join ---
MEETING_ID=
MEETING_PASSWORD=
# Optional: ZAK token if you're auto-starting as the host
MEETING_ZAK=

# --- Zoom SDK credentials ---
# Used by the bridge; kept here so .env is the single source of truth.
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=

# --- LLM (OpenRouter — free models available at openrouter.ai/models) ---
OPENROUTER_API_KEY=
ANTHROPIC_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Bot identity ---
BOT_DISPLAY_NAME=Om Asnani AI
BOT_AVATAR_URL=https://example.com/om_asnani.jpg
BOT_DISCLOSURE_LINE=Hi! I'm Om Asnani's AI co-host — happy to help while he's presenting.

# --- Host control (slash commands) ---
HOST_EMAIL=you@example.com

# --- Behavior ---
GREET_NEW_ATTENDEES=true
GREET_DELAY_SECONDS=3
GREET_MAX_PER_MINUTE=10
ANSWER_QUESTIONS=true
ANSWER_RATE_LIMIT_PER_USER_PER_MIN=2

# --- RAG ---
KNOWLEDGE_DIR=./knowledge
VECTOR_STORE_PATH=./vector_store
EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_TOP_K=4
