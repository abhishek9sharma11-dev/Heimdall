FROM --platform=linux/arm64 mcr.microsoft.com/playwright:v1.59.1-jammy

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    HERMES_HOST=0.0.0.0 \
    HERMES_WORKER_MODE=1 \
    HERMES_DOCKER=1 \
    HERMES_DISABLE_DAY_OPS=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv curl ca-certificates tini \
    && rm -rf /var/lib/apt/lists/*

COPY requirements-lite.txt .
RUN python3 -m pip install --no-cache-dir --break-system-packages -r requirements-lite.txt

COPY bridge/node-bridge/package.json bridge/node-bridge/package-lock.json* ./bridge/node-bridge/
RUN cd bridge/node-bridge && npm install --omit=dev

COPY . .

RUN chmod +x scripts/hermes_slots.sh && \
    python3 -m py_compile dashboard/server.py src/main.py

EXPOSE 8780

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["python3", "-m", "dashboard.server"]
